# Ассистенттің жауабын генерациялайтын негізгі LLM (backend/llm.py)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Резервте қалдырылған, қазір қолданылмайды (backend/gemini.py)
